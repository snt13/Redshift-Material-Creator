    def InitValues(self):
        self.SetString(self.FOLDER_INPUT, "")
        # Blank by default: the material is then named after the texture set,
        # which is what you want most of the time.
        self.SetString(self.MATERIAL_NAME_INPUT, "")
        default_texts = {
            "BaseColor": "BaseColor, Albedo",
            "Roughness": "Roughness, Rough",
            "Normal": "Normal, Nrm",
            "Displacement": "Displacement, Height",
            "Opacity": "Opacity, Alpha",
            "Metalness": "Metalness, Metallic, Mtl"
        }
        for ch, cb in self.CHECKBOX_IDS.items():
            default_state = False if ch in ("Opacity", "Metalness") else True
            self.SetBool(cb, default_state)
            self.SetString(self.TEXTBOX_IDS[ch], default_texts[ch])
            self.Enable(self.TEXTBOX_IDS[ch], True)

        self.SetBool(self.IMPORT_3D_MODEL_CHECKBOX, False)
        self.SetBool(self.AO_CHECKBOX, False)
        self.SetBool(self.COPY_TEXTURES_CHECKBOX, False)
        self.SetBool(self.GAME_ASSET_CHECKBOX, False)
        # Off by default. Substance does export DirectX normals, but plenty of
        # sources are already OpenGL and a wrong flip is harder to spot than a
        # missing one - so this is opt-in.
        self.SetBool(self.FLIP_GREEN_CHECKBOX, False)

        # Triplanar ignores UVs entirely, so it must be opt-in: turning it on
        # for a model with baked UVs would quietly destroy the look.
        self.SetBool(self.TRIPLANAR_CHECKBOX, False)
        # Redshift's own triplanar scale. Smaller number, bigger texture.
        self.SetFloat(self.TRIPLANAR_SIZE_INPUT, TRIPLANAR_DEFAULT_SIZE,
                      0.000001, 1000000.0, 0.001)

        self.SetBool(self.CURVATURE_CHECKBOX, False)
        self.SetInt32(self.EXISTING_POLICY_COMBO, EXISTING_UPDATE)
        self.SetString(self.STATUS_TEXT, "")
        self.sync_enabled_state()

        self.result = None
        return True

    def sync_enabled_state(self):
        """
        Only the Size field, which is meaningless with Triplanar off.

        AO and Curvature are deliberately NOT mutually exclusive - v1.9 greyed
        AO out when Curvature was ticked, which was a judgement call the tool
        had no business making. They do different things to different parts of
        the graph and running both is a legitimate look.
        """
        self.Enable(self.TRIPLANAR_SIZE_INPUT, self.GetBool(self.TRIPLANAR_CHECKBOX))

    def status(self, message):
        self.SetString(self.STATUS_TEXT, message)

    # ----------------------------------------------
    # Folder scan (shared by Preview and Create)
    # ----------------------------------------------
    def collect_keywords(self):
        """Enabled channels and their keyword lists, as typed in the dialog."""
        channel_keywords = {}
        for ch in self.CHECKBOX_IDS:
            if not self.GetBool(self.CHECKBOX_IDS[ch]):
                continue
            keywords = [k.strip() for k in self.GetString(self.TEXTBOX_IDS[ch]).split(',')]
            channel_keywords[ch] = [k for k in keywords if k]

        # AO has no row of its own. Its keywords are fixed and are only
        # searched for when the AO checkbox is on, so a set with no AO map
        # simply falls through to the procedural node.
        if self.GetBool(self.AO_CHECKBOX):
            channel_keywords["AO"] = list(AO_KEYWORDS)

        return channel_keywords

    def extra_options(self):
        """Everything on the dialog that is not a texture channel."""
        return {
            "ao": self.GetBool(self.AO_CHECKBOX),
            "gameAsset": self.GetBool(self.GAME_ASSET_CHECKBOX),
            "flipGreen": self.GetBool(self.FLIP_GREEN_CHECKBOX),
            "triplanar": self.GetBool(self.TRIPLANAR_CHECKBOX),
            "triplanarSize": self.GetFloat(self.TRIPLANAR_SIZE_INPUT),
            "curvature": self.GetBool(self.CURVATURE_CHECKBOX),
            "existingPolicy": self.GetInt32(self.EXISTING_POLICY_COMBO),
        }

    def scan(self, folder):
        # Subfolders are always included - texture sets are normally exported
        # one folder per material.
        return scan_folder(folder, self.collect_keywords())

    def Command(self, id, msg):
        if id == self.SELECT_FOLDER_BUTTON:
            folder = storage.LoadDialog(title="Select a Folder", flags=c4d.FILESELECT_DIRECTORY)
            if folder:
                self.SetString(self.FOLDER_INPUT, folder)

        if id == self.PREVIEW_MATERIAL_BUTTON:
            folder = self.GetString(self.FOLDER_INPUT).strip()
            if not folder or not os.path.exists(folder):
                gui.MessageDialog("Please select a valid folder.")
                return True

            channel_files, display_names, set_folders = self.scan(folder)
            channels = [ch for ch in CHANNEL_ORDER if ch in channel_files]

            keys = set()
            for ch in channels:
                keys |= set(channel_files[ch].keys())
            if not keys:
                gui.MessageDialog("No texture files found.")
                return True

            base = self.GetString(self.MATERIAL_NAME_INPUT).strip()
            opts = self.extra_options()
            preview = "Normal source: {}\n".format(
                "DirectX (green channel flipped)" if opts["flipGreen"]
                else "OpenGL (unchanged)"
            )
            preview += "Triplanar: {}\n".format(
                "on, size {:g}".format(opts["triplanarSize"])
                if opts["triplanar"] else "off"
            )
            preview += "Curvature blend: {}\n\n".format(
                "on" if opts["curvature"] else "off")
            for key in sorted(keys):
                preview += "Material: {}\n".format(
                    build_material_name(base, display_names.get(key, ""))
                )
                if self.GetBool(self.IMPORT_3D_MODEL_CHECKBOX):
                    set_folder = set_folders.get(key, "")
                    try:
                        shown = os.path.relpath(set_folder, folder)
                    except Exception:
                        shown = set_folder
                    preview += "  folder: {}\n".format(
                        "." if shown in ("", ".") else shown)
                for ch in channels:
                    if channel_files[ch].get(key):
                        preview += "  {}: {}\n".format(
                            ch, os.path.basename(channel_files[ch][key])
                        )
                preview += "\n"

            # A scrollable read-only dialog, not gui.MessageDialog - with
            # thirty texture sets that string is unreadable and can truncate.
            PreviewDialog(preview).Open(dlgtype=c4d.DLG_TYPE_MODAL,
                                        defaultw=620, defaulth=460)

        if id == self.TRIPLANAR_CHECKBOX:
            self.sync_enabled_state()

        if id == self.CREATE_MATERIAL_BUTTON:
            folder = self.GetString(self.FOLDER_INPUT).strip()
            if not folder or not os.path.exists(folder):
                gui.MessageDialog("Please select a valid folder.")
                return True

            channel_files, display_names, set_folders = self.scan(folder)
            channels = [ch for ch in CHANNEL_ORDER if ch in channel_files]

            keys = set()
            for ch in channels:
                keys |= set(channel_files[ch].keys())
            if not keys:
                gui.MessageDialog("No texture files found.")
                return True

            materialSets = {}
            base = self.GetString(self.MATERIAL_NAME_INPUT).strip()
            for key in sorted(keys):
                ident = display_names.get(key, "")
                ms = {ch: channel_files[ch].get(key) for ch in channels}
                ms["materialName"] = build_material_name(base, ident)
                ms["identifier"] = ident
                ms["sourceFolder"] = set_folders.get(key, "")
                ms.update(self.extra_options())
                materialSets[key] = ms

            settings = {
                "materialSets": materialSets,
                "folder": folder,
                "importObject": self.GetBool(self.IMPORT_3D_MODEL_CHECKBOX),
                "copyTextures": self.GetBool(self.COPY_TEXTURES_CHECKBOX),
                "gameAsset": self.GetBool(self.GAME_ASSET_CHECKBOX),
                "flipGreen": self.GetBool(self.FLIP_GREEN_CHECKBOX),
                "existingPolicy": self.GetInt32(self.EXISTING_POLICY_COMBO),
            }
            self.result = settings

            # The dialog is async and stays open - the work happens here
            # rather than after Close(), so you can adjust and run again.
            self.Enable(self.CREATE_MATERIAL_BUTTON, False)
            try:
                report = build_materials(settings, status=self.status)
            finally:
                self.Enable(self.CREATE_MATERIAL_BUTTON, True)
            self.status(format_report_line(report))
            report_problems(report)

        return True


