"""
Redshift Material Creator for Cinema 4D
=======================================

Batch-builds Redshift node materials from a folder of PBR texture maps.
Point it at an export folder, it groups the maps into material sets by
filename and wires up a StandardMaterial for each one.

Verified against Cinema 4D 2025.3 + Redshift.

Runs two ways from this one file:
  * Script Manager - keep the .py extension and hit Execute.
  * Plugin - copy it into a Cinema 4D "plugins" folder and rename it to
    .pyp. It then registers a command you can put in a menu or bind to a
    shortcut. (Register a real PLUGIN_ID at developers.maxon.net first.)

Version history lives in CHANGELOG.md next to this file, not here.
Tests: python test_material_creator.py  (runs outside Cinema 4D).
"""

__version__ = "2.7"

import c4d
import maxon
import os
import re
import shutil
from c4d import gui, storage

# --------------------------------------------------
# Configuration
# --------------------------------------------------

# Characters treated as word separators when matching a keyword against a
# filename. They are ignored for MATCHING but preserved in the returned name.
SEPARATOR_CHARS = "_- ."

# Only these extensions are considered texture files.
TEXTURE_EXTENSIONS = {
    ".png", ".jpg", ".jpeg", ".tif", ".tiff", ".exr", ".tga"
}


# --------------------------------------------------
# Helper: normalize a string for matching, keeping a map back to the original
# --------------------------------------------------
def _normalize_with_map(text):
    """
    Returns (normalized, index_map) where `normalized` is `text` lowercased
    with all separator characters removed, and index_map[i] is the index in
    the ORIGINAL text of the i-th character of `normalized`.
    """
    normalized = []
    index_map = []
    for i, ch in enumerate(text):
        if ch in SEPARATOR_CHARS:
            continue
        normalized.append(ch.lower())
        index_map.append(i)
    return "".join(normalized), index_map


def _strip_separators(text):
    return text.strip(SEPARATOR_CHARS)


# --------------------------------------------------
# Helper: Extract identifier from filename using a given keyword
#
# The keyword is matched case-insensitively and ignoring separators, but the
# returned identifier keeps the ORIGINAL spelling of the filename, including
# underscores and capitalisation.
#
#   "T_Wood_Planks_BaseColor_2K.png" + "BaseColor" -> "T_Wood_Planks_2K"
#   "Rock_Rough.png"                 + "Rough"     -> "Rock"
#   "BaseColor.png"                  + "BaseColor" -> ""   (matched, no name)
#   "Rock_Normal.png"                + "Rough"     -> None (no match)
# --------------------------------------------------
def extract_identifier(file_name, keyword, require_boundary=False):
    """
    `require_boundary` makes the keyword match only where it is delimited by a
    separator or by the start/end of the name. Matching normally ignores
    separators entirely, which is right for long keywords but dangerous for
    very short ones: "AO" otherwise matches the letters inside
    "Cacao_BaseColor". See BOUNDARY_MATCH_CHANNELS.
    """
    base = os.path.splitext(file_name)[0]

    norm_base, index_map = _normalize_with_map(base)
    norm_keyword, _ = _normalize_with_map(keyword)
    if not norm_keyword:
        return None

    pos = norm_base.rfind(norm_keyword)
    while require_boundary and pos >= 0:
        first = index_map[pos]
        last = index_map[pos + len(norm_keyword) - 1]
        before_ok = first == 0 or base[first - 1] in SEPARATOR_CHARS
        after_ok = last == len(base) - 1 or base[last + 1] in SEPARATOR_CHARS
        if before_ok and after_ok:
            break
        pos = norm_base.rfind(norm_keyword, 0, pos)
    if pos < 0:
        return None

    start = index_map[pos]
    end = index_map[pos + len(norm_keyword) - 1] + 1

    before = _strip_separators(base[:start])
    after = _strip_separators(base[end:])

    if before and after:
        return "{}_{}".format(before, after)
    return before or after


# Tokens Substance and friends append to normal maps to note their format.
# They are dropped from the identifier so that "Wood_Normal_DirectX.png" still
# groups with "Wood_BaseColor.png" instead of creating a second material.
NORMAL_FORMAT_TOKENS = {"directx", "dx", "opengl", "ogl", "gl"}


def strip_normal_format_tokens(identifier):
    if not identifier:
        return identifier
    parts = re.split(r'([{}])'.format(re.escape(SEPARATOR_CHARS)), identifier)
    kept = [p for p in parts
            if p in SEPARATOR_CHARS or p.lower() not in NORMAL_FORMAT_TOKENS]
    joined = "".join(kept)
    # Dropping a token from the MIDDLE leaves its separators on both sides:
    # "Wood_OpenGL_2K" -> "Wood__2K". Collapse any run back to one.
    joined = re.sub(r'[{}]{{2,}}'.format(re.escape(SEPARATOR_CHARS)),
                    lambda match: match.group(0)[0], joined)
    return _strip_separators(joined)


def identifier_key(identifier):
    """Case/separator-insensitive key used to group maps into one material."""
    norm, _ = _normalize_with_map(identifier or "")
    return norm


# --------------------------------------------------
# Helper: Recursively gather all objects under a root
# --------------------------------------------------
def get_all_objects(obj):
    result = []
    while obj:
        result.append(obj)
        result += get_all_objects(obj.GetDown())
        obj = obj.GetNext()
    return result


# --------------------------------------------------
# Helper: port lookup that tolerates Redshift/maxon API differences
# --------------------------------------------------
def _iter_ports(port_list):
    if port_list is None:
        return []
    try:
        children = port_list.GetChildren()
        if children:
            return list(children)
    except Exception:
        pass
    collected = []
    try:
        def _cb(child):
            collected.append(child)
            return True
        port_list.GetChildren(_cb, maxon.NODE_KIND.INPORT)
    except Exception:
        pass
    return collected


def find_port(port_list, exact_ids=None, suffixes=None):
    """
    Find a port by full id first, then by id suffix. Returns None if absent.
    """
    if port_list is None:
        return None

    for pid in (exact_ids or []):
        try:
            port = port_list.FindChild(pid)
            if port:
                return port
        except Exception:
            pass

    if suffixes:
        ports = _iter_ports(port_list)
        for suffix in suffixes:
            suffix = suffix.lower()
            for port in ports:
                try:
                    if str(port.GetId()).lower().endswith(suffix):
                        return port
                except Exception:
                    continue
    return None


def _set_color_port(port, r, g, b):
    """Set a color-ish port, trying the types Redshift may expose."""
    if port is None:
        return False
    for value in (maxon.Color(r, g, b), maxon.Vector(r, g, b)):
        try:
            port.SetDefaultValue(value)
            return True
        except Exception:
            continue
    return False


# --------------------------------------------------
# Normal map green-channel flip
# --------------------------------------------------
def apply_normal_flip(bump_node, texture_node):
    """
    Flip the green (Y) channel of a tangent-space normal map.
    DirectX-authored normals (Substance default) need this for Redshift,
    which expects OpenGL orientation.

    Preferred path: the Bump Map node's own Flip Y switch.
    Fallback: invert green on the Texture Sampler via colour multiplier/offset
              ( out = tex * (1,-1,1) + (0,1,0) ).
    """
    flip_port = find_port(
        bump_node.GetInputs(),
        exact_ids=[
            "com.redshift3d.redshift4c4d.nodes.core.bumpmap.flipy",
            "com.redshift3d.redshift4c4d.nodes.core.bumpmap.flip_y",
        ],
        suffixes=["flipy", "flip_y", "flipbitangent", "flip_bitangent"],
    )
    if flip_port is not None:
        try:
            flip_port.SetDefaultValue(maxon.Bool(True))
            return "bumpmap.flipY"
        except Exception:
            pass

    inputs = texture_node.GetInputs()
    mult = find_port(
        inputs,
        exact_ids=["com.redshift3d.redshift4c4d.nodes.core.texturesampler.color_multiplier"],
        suffixes=["color_multiplier", "colormultiplier"],
    )
    offset = find_port(
        inputs,
        exact_ids=["com.redshift3d.redshift4c4d.nodes.core.texturesampler.color_offset"],
        suffixes=["color_offset", "coloroffset"],
    )
    if _set_color_port(mult, 1.0, -1.0, 1.0) and _set_color_port(offset, 0.0, 1.0, 0.0):
        return "textureSampler multiplier/offset"

    print("[Material Creator] Could not flip the normal map's green channel "
          "- no Flip Y port and no colour multiplier/offset on this Redshift build.")
    return None


# --------------------------------------------------
# Node graph helpers
#
# Every Redshift node and port is addressed by a long dotted id. GraphBuilder
# takes the short form ("texturesampler.outcolor"), expands it, resolves the
# port and - crucially - records a readable message when something is missing.
#
# v1.1 used the idiom `a and b and a.Connect(b)`, which silently produced a
# material with a missing wire and no indication that anything went wrong.
# Every connection now either happens or shows up in `warnings`.
# --------------------------------------------------
RS_NODESPACE = maxon.Id("com.redshift3d.redshift4c4d.class.nodespace")
RS_NODE_PREFIX = "com.redshift3d.redshift4c4d.nodes.core."
RS_OUTPUT_NODE = "com.redshift3d.redshift4c4d.node.output"


def rs_node_id(short_id):
    """'texturesampler' -> maxon.Id('com...nodes.core.texturesampler')."""
    if short_id.startswith("com."):
        return maxon.Id(short_id)
    return maxon.Id(RS_NODE_PREFIX + short_id)


def rs_port_id(short_id):
    """'bumpmap.out' -> 'com...nodes.core.bumpmap.out'. Full ids pass through."""
    if short_id.startswith("com."):
        return short_id
    return RS_NODE_PREFIX + short_id


class GraphBuilder(object):
    """
    Thin wrapper around one Redshift node graph.

    Methods return True/False rather than raising, and append a short message
    to `self.warnings` whenever a node or port could not be resolved, so the
    caller can report everything that went wrong in one dialog at the end.
    """

    def __init__(self, graph, material_name=""):
        self.graph = graph
        self.material_name = material_name or "material"
        self.warnings = []

    # ---- reporting ------------------------------------------------
    def warn(self, message):
        text = "[{}] {}".format(self.material_name, message)
        self.warnings.append(text)
        print("[Material Creator] " + text)

    # ---- creation -------------------------------------------------
    def add(self, short_id, name=None):
        """Create a node. Returns the node, or None (and warns) on failure."""
        try:
            node = self.graph.AddChild("", rs_node_id(short_id), maxon.DataDictionary())
        except Exception as exc:
            self.warn("could not create node '{}' ({})".format(short_id, exc))
            return None
        if node is None:
            self.warn("could not create node '{}'".format(short_id))
            return None
        if name:
            self.set_name(node, name)
        return node

    def set_name(self, node, name):
        """Label a node in the node editor. Cosmetic - never fatal."""
        if node is None:
            return False
        try:
            node.SetValue(maxon.NODE.BASE.NAME, maxon.String(name))
            return True
        except Exception:
            return False

    # ---- ports ----------------------------------------------------
    def port(self, node, short_port, direction="in"):
        """
        Resolve a port by full id, falling back to a suffix match so the tool
        survives small port-id changes between Redshift builds.
        """
        if node is None:
            return None
        try:
            port_list = node.GetInputs() if direction == "in" else node.GetOutputs()
        except Exception:
            return None
        full = rs_port_id(short_port)
        return find_port(port_list, exact_ids=[full], suffixes=[full.rsplit(".", 1)[-1]])

    def connect(self, src_node, src_port, dst_node, dst_port):
        """Wire one output to one input."""
        out = self.port(src_node, src_port, "out")
        inp = self.port(dst_node, dst_port, "in")
        if out is None:
            self.warn("output port '{}' not found".format(src_port))
            return False
        if inp is None:
            self.warn("input port '{}' not found".format(dst_port))
            return False
        try:
            out.Connect(inp)
            return True
        except Exception as exc:
            self.warn("could not connect {} -> {} ({})".format(src_port, dst_port, exc))
            return False

    def connect_from(self, source, dst_node, dst_port):
        """
        Wire from a (node, port) pair - the form the per-channel `chain` dict
        uses, so inserting a node mid-chain is a one-line change.
        """
        if not source or source[0] is None:
            return False
        return self.connect(source[0], source[1], dst_node, dst_port)

    # ---- values ---------------------------------------------------
    def set_value(self, node, short_port, value):
        port = self.port(node, short_port, "in")
        if port is None:
            self.warn("input port '{}' not found - value not set".format(short_port))
            return False
        try:
            port.SetDefaultValue(value)
            return True
        except Exception as exc:
            self.warn("could not set '{}' ({})".format(short_port, exc))
            return False

    def set_color(self, node, short_port, r, g, b):
        port = self.port(node, short_port, "in")
        if port is None:
            self.warn("input port '{}' not found - colour not set".format(short_port))
            return False
        if _set_color_port(port, r, g, b):
            return True
        self.warn("could not set colour on '{}'".format(short_port))
        return False

    # ---- rewiring --------------------------------------------------
    def disconnect(self, src_node, src_port, dst_node, dst_port):
        """
        Remove an existing wire. Connecting a second source to an input does
        NOT replace the first one in a maxon graph - both survive - so the
        default StandardMaterial -> Output.surface wire has to be removed
        before the Material Blender can take its place.
        """
        out = self.port(src_node, src_port, "out")
        inp = self.port(dst_node, dst_port, "in")
        if out is None or inp is None:
            self.warn("could not disconnect {} -> {} (port missing)".format(
                src_port, dst_port))
            return False
        try:
            maxon.GraphModelHelper.RemoveConnection(out, inp)
            return True
        except Exception as exc:
            self.warn("could not disconnect {} -> {} ({})".format(
                src_port, dst_port, exc))
            return False

    def set_texture(self, node, path, colorspace):
        """
        Point a TextureSampler at a file. Path and colorspace live on children
        of the `tex0` port, not on tex0 itself.
        """
        tex0 = self.port(node, "texturesampler.tex0", "in")
        if tex0 is None:
            self.warn("texture sampler has no 'tex0' port - '{}' not loaded".format(
                os.path.basename(path)))
            return False
        ok = True
        try:
            cs = tex0.FindChild("colorspace")
            if cs:
                cs.SetDefaultValue(colorspace)
            else:
                ok = False
        except Exception:
            ok = False
        try:
            p = tex0.FindChild("path")
            if p:
                p.SetDefaultValue(maxon.Url(path))
            else:
                ok = False
                self.warn("could not set texture path for '{}'".format(
                    os.path.basename(path)))
        except Exception as exc:
            ok = False
            self.warn("could not set texture path for '{}' ({})".format(
                os.path.basename(path), exc))
        return ok

    def find_single(self, short_id, label):
        """Find the one node of a given asset id in the default graph."""
        found = []
        try:
            maxon.GraphModelHelper.FindNodesByAssetId(
                self.graph, rs_node_id(short_id), True, found)
        except Exception as exc:
            self.warn("could not look up {} ({})".format(label, exc))
            return None
        if not found:
            self.warn("{} node not found in the default graph".format(label))
            return None
        return found[0]


# --------------------------------------------------
# Channel table
#
# Adding a channel is now one entry here plus one wiring block below, instead
# of a new branch copied from an existing one.
# --------------------------------------------------
MATERIAL_CHANNELS = ["BaseColor", "AO", "Roughness", "Normal",
                     "Displacement", "Opacity", "Metalness"]

# BaseColor is the only colour map - everything else is data and stays RAW.
# AO has no keyword field in the dialog - the single AO checkbox in Options
# drives everything. These are only searched for when that box is ticked,
# which also means the short "AO" spelling can never produce a false positive
# on a run that is not using AO at all.
AO_KEYWORDS = ["AmbientOcclusion", "Ambient_Occlusion", "Occlusion", "AO"]

# Channels whose keywords must sit on a separator boundary in the filename.
# Matching normally ignores separators, which is what lets "base color" match
# "BaseColor" - but it also means a two-letter keyword matches anywhere, and
# "AO" was being found inside "Cacao_BaseColor".
BOUNDARY_MATCH_CHANNELS = ("AO",)

CHANNEL_COLORSPACES = {
    "BaseColor": "RS_INPUT_COLORSPACE_SRGB",
    "AO": "RS_INPUT_COLORSPACE_RAW",
    "Roughness": "RS_INPUT_COLORSPACE_RAW",
    "Normal": "RS_INPUT_COLORSPACE_RAW",
    "Displacement": "RS_INPUT_COLORSPACE_RAW",
    "Opacity": "RS_INPUT_COLORSPACE_RAW",
    "Metalness": "RS_INPUT_COLORSPACE_RAW",
}

# With "Game Asset" on, these maps are greyscale packed into RGB, so they go
# through a ColorSplitter and only the red channel is used.
GAME_ASSET_SPLIT_CHANNELS = ("Roughness", "Opacity", "AO")

# Redshift's own default for triplanar.scale. The dialog's Size field holds
# this value directly - smaller number, bigger texture.
TRIPLANAR_DEFAULT_SIZE = 0.01

# Look of the generated blend material (layer 1 of the Material Blender).
BLEND_MATERIAL_COLOR = (0.09, 0.06, 0.04)
BLEND_MATERIAL_ROUGHNESS = 0.85
BLEND_MATERIAL_METALNESS = 0.0


# --------------------------------------------------
# Material Creation
#
# Returns (material, warnings). `warnings` is empty when every node and port
# resolved; the caller collects them across the batch and reports once.
# --------------------------------------------------
def create_redshift_material(file_paths):
    doc = c4d.documents.GetActiveDocument()
    if not doc:
        return None, ["No active document."]

    material_name = file_paths.get("materialName", "RS Material")

    # Built directly instead of through c4d.CallCommand(1040254, 1012), the
    # Redshift preset menu. That relied on an undocumented menu id, hijacked
    # whatever material happened to be active, and gave no handle on the
    # moment of insertion - which is exactly what undo support needs.
    mat = c4d.BaseMaterial(c4d.Mmaterial)
    mat.SetName(material_name)

    node_material = mat.GetNodeMaterialReference()
    if node_material is None:
        return None, ["'{}' has no node material.".format(material_name)]

    graph = node_material.CreateDefaultGraph(RS_NODESPACE)
    if graph is None or graph.IsNullValue():
        return None, ["'{}' - could not create the Redshift graph.".format(material_name)]

    gb = GraphBuilder(graph, material_name)

    std_node = gb.find_single("standardmaterial", "Standard Material")
    output_node = gb.find_single(RS_OUTPUT_NODE, "Output")
    if std_node is None or output_node is None:
        return None, gb.warnings

    game_asset = file_paths.get("gameAsset", False)
    flip_green = file_paths.get("flipGreen", False)

    triplanar = file_paths.get("triplanar", False)
    tri_size = float(file_paths.get("triplanarSize", TRIPLANAR_DEFAULT_SIZE))

    curvature_blend = file_paths.get("curvature", False)

    # chain[channel] = (node, output_port) - the current end of that channel's
    # signal path. Every step reads it, wires from it, and overwrites it.
    chain = {}
    texture_nodes = {}

    with graph.BeginTransaction() as tr:
        try:
            # 1) One column per channel: Texture Sampler -> [TriPlanar]
            #    -> [ColorSplitter]. Built channel by channel rather than
            #    layer by layer, so each channel's nodes end up adjacent in
            #    the node editor instead of interleaved.
            size_node = None
            if triplanar:
                size_node = gb.add("rsscalarconstant", "Size")
                gb.set_value(size_node, "rsscalarconstant.val",
                             maxon.Float64(tri_size))

            for ch in MATERIAL_CHANNELS:
                path = file_paths.get(ch)
                if not path:
                    continue
                # An AO map is only worth loading if AO is switched on -
                # otherwise it would sit in the graph unconnected.
                if ch == "AO" and not file_paths.get("ao"):
                    continue

                tn = gb.add("texturesampler", "{} Tex".format(ch))
                if tn is None:
                    continue
                gb.set_texture(tn, path, CHANNEL_COLORSPACES.get(
                    ch, "RS_INPUT_COLORSPACE_RAW"))
                texture_nodes[ch] = tn
                chain[ch] = (tn, "texturesampler.outcolor")

                # TriPlanar, with its Scale wired straight to the shared
                # Size node.
                if size_node is not None:
                    tp = gb.add("triplanar", "{} Triplanar".format(ch))
                    if tp is not None:
                        gb.connect_from(chain[ch], tp, "triplanar.imagex")

                        # One image on all three axes. If that switch is
                        # missing on this Redshift build, wire Y and Z by hand.
                        if not gb.set_value(tp, "triplanar.sameimageoneachaxis",
                                            maxon.Bool(True)):
                            gb.connect_from(chain[ch], tp, "triplanar.imagey")
                            gb.connect_from(chain[ch], tp, "triplanar.imagez")

                        gb.connect(size_node, "rsscalarconstant.out",
                                   tp, "triplanar.scale")

                        chain[ch] = (tp, "triplanar.outcolor")

                # Game Asset: packed greyscale map, keep red.
                if game_asset and ch in GAME_ASSET_SPLIT_CHANNELS:
                    sp = gb.add("rscolorsplitter", "{} Split".format(ch))
                    if sp is not None:
                        gb.connect_from(chain[ch], sp, "rscolorsplitter.input")
                        chain[ch] = (sp, "rscolorsplitter.outr")


            # 2) BaseColor -> ColorCorrection -> (AO?) -> standard.base_color
            if "BaseColor" in chain:
                cc = gb.add("rscolorcorrection", "BaseColor CC")
                if cc is not None:
                    gb.connect_from(chain["BaseColor"], cc, "rscolorcorrection.input")
                    chain["BaseColor"] = (cc, "rscolorcorrection.outcolor")

                # AO. A baked map is always better than a procedural guess,
                # so if the texture set has one it wins; the Redshift
                # ambient-occlusion node is the fallback when it does not.
                if file_paths.get("ao"):
                    if "AO" in chain:
                        mul = gb.add("rsmathmulvector", "AO Multiply")
                        if mul is not None:
                            gb.connect_from(chain["BaseColor"], mul,
                                            "rsmathmulvector.input1")
                            gb.connect_from(chain["AO"], mul,
                                            "rsmathmulvector.input2")
                            chain["BaseColor"] = (mul, "rsmathmulvector.out")
                    else:
                        ao = gb.add("ambientocclusion", "AO")
                        if ao is not None:
                            gb.connect_from(chain["BaseColor"], ao,
                                            "ambientocclusion.bright")
                            chain["BaseColor"] = (ao, "ambientocclusion.out")

                gb.connect_from(chain["BaseColor"], std_node,
                                "standardmaterial.base_color")

            # 3) Roughness -> Ramp -> standard.refl_roughness
            if "Roughness" in chain:
                ramp = gb.add("rsramp", "Roughness Ramp")
                if ramp is not None:
                    gb.connect_from(chain["Roughness"], ramp, "rsramp.input")
                    chain["Roughness"] = (ramp, "rsramp.outcolor")
                gb.connect_from(chain["Roughness"], std_node,
                                "standardmaterial.refl_roughness")

            # 4) Normal -> BumpMap (tangent-space normal) -> standard.bump_input
            if "Normal" in chain:
                bm = gb.add("bumpmap", "Normal Bump")
                if bm is not None:
                    gb.set_value(bm, "bumpmap.inputtype", maxon.Int32(1))

                    # DirectX source (Substance default) -> flip Y for Redshift.
                    # OpenGL source -> leave untouched.
                    if flip_green:
                        method = apply_normal_flip(bm, texture_nodes.get("Normal"))
                        if method is None:
                            gb.warn("normal green channel could not be flipped - "
                                    "no Flip Y port and no colour multiplier/offset")

                    gb.connect_from(chain["Normal"], bm, "bumpmap.input")
                    chain["Normal"] = (bm, "bumpmap.out")
                    gb.connect_from(chain["Normal"], std_node,
                                    "standardmaterial.bump_input")

            # 5) Displacement -> output.displacement
            if "Displacement" in chain:
                dp = gb.add("displacement", "Displacement")
                if dp is not None:
                    gb.connect_from(chain["Displacement"], dp, "displacement.texmap")
                    chain["Displacement"] = (dp, "displacement.out")
                    gb.connect_from(chain["Displacement"], output_node,
                                    RS_OUTPUT_NODE + ".displacement")

            # 6) Opacity -> standard.opacity_color
            if "Opacity" in chain:
                gb.connect_from(chain["Opacity"], std_node,
                                "standardmaterial.opacity_color")

            # 7) Metalness -> standard.metalness
            if "Metalness" in chain:
                gb.connect_from(chain["Metalness"], std_node,
                                "standardmaterial.metalness")

            # 8) Curvature blend.
            #
            #     Curvature -> Mul (intensity) -> Mul (x mask texture) -> the
            #     Material Blender's blend mask. The textured material becomes
            #     the blender's base, a generated blend material its layer 1.
            #
            #     Intensity, radius and the mask texture are deliberately NOT
            #     in the dialog - the nodes are built and tuned in the node
            #     editor, where you can see what you are doing.
            if curvature_blend:
                blender = gb.add("materialblender", "Curvature Blender")
                blend_mat = gb.add("standardmaterial", "Blend Material")
                gb.set_color(blend_mat, "standardmaterial.base_color",
                             *BLEND_MATERIAL_COLOR)
                gb.set_value(blend_mat, "standardmaterial.refl_roughness",
                             maxon.Float64(BLEND_MATERIAL_ROUGHNESS))
                gb.set_value(blend_mat, "standardmaterial.metalness",
                             maxon.Float64(BLEND_MATERIAL_METALNESS))

                curv = gb.add("curvature", "Curvature")

                mul_intensity = gb.add("rsmathmul", "Curvature Intensity")
                gb.connect(curv, "curvature.out", mul_intensity, "rsmathmul.input1")

                mask_tex = gb.add("texturesampler", "Curvature Texture")
                mask_cc = gb.add("rscolorcorrection", "Curvature CC")
                gb.connect(mask_tex, "texturesampler.outcolor",
                           mask_cc, "rscolorcorrection.input")

                mul_mask = gb.add("rsmathmul", "Curvature Mask")
                gb.connect(mul_intensity, "rsmathmul.out", mul_mask, "rsmathmul.input1")
                gb.connect(mask_cc, "rscolorcorrection.outcolor",
                           mul_mask, "rsmathmul.input2")

                # The default graph already wires StandardMaterial -> surface.
                # A second connection would not replace it, so remove it first.
                gb.disconnect(std_node, "standardmaterial.outcolor",
                              output_node, RS_OUTPUT_NODE + ".surface")
                gb.connect(std_node, "standardmaterial.outcolor",
                           blender, "materialblender.basecolor")
                gb.connect(blend_mat, "standardmaterial.outcolor",
                           blender, "materialblender.layercolor1")
                gb.connect(mul_mask, "rsmathmul.out",
                           blender, "materialblender.blendcolor1")
                gb.connect(blender, "materialblender.out",
                           output_node, RS_OUTPUT_NODE + ".surface")

                # Console note only - the empty texture node is intentional, so
                # this is not a warning the summary dialog needs to nag about.
                print("[Material Creator] [{}] 'Curvature Texture' is empty by "
                      "design. An unassigned texture sampler outputs black, so "
                      "the curvature mask reads zero until a map is loaded into "
                      "it.".format(material_name))

            tr.Commit()
        except Exception as exc:
            tr.Rollback()
            gb.warn("graph build failed, changes rolled back ({})".format(exc))
            return None, gb.warnings

    # Inserted only once the graph is complete, so the material appears fully
    # built and a single undo step removes it.
    doc.InsertMaterial(mat)
    try:
        doc.AddUndo(c4d.UNDOTYPE_NEW, mat)
    except Exception:
        pass  # called outside a StartUndo/EndUndo block - not fatal
    c4d.EventAdd()
    return mat, gb.warnings


# Fixed gadget widths.
#
# A Cinema 4D checkbox whose initw is narrower than its label gets CLIPPED,
# not wrapped, and the full text only shows in the tooltip. Both of these are
# sized off the LONGEST label in their column with room to spare, so they hold
# up at other UI scales and font settings too:
#   channels - "Displacement"
#   options  - "Game Asset"
# Anything else in the dialog uses initw=0, which sizes itself to its text.
CHANNEL_LABEL_WIDTH = 150

