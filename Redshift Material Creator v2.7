class PreviewDialog(gui.GeDialog):
    TEXT = 2000

    def __init__(self, text):
        super(PreviewDialog, self).__init__()
        self._text = text

    def CreateLayout(self):
        self.SetTitle("Preview Materials")
        self.AddMultiLineEditText(
            self.TEXT, c4d.BFH_SCALEFIT | c4d.BFV_SCALEFIT, 600, 420,
            c4d.DR_MULTILINE_READONLY | c4d.DR_MULTILINE_MONOSPACED)
        self.AddDlgGroup(c4d.DLG_OK)
        return True

    def InitValues(self):
        self.SetString(self.TEXT, self._text)
        return True

    def Command(self, id, msg):
        # AddDlgGroup only draws the button - without this the OK click was
        # swallowed and the window just sat there.
        if id in (c4d.DLG_OK, c4d.DLG_CANCEL):
            self.Close()
        return True


# --------------------------------------------------
# Model import
# --------------------------------------------------
def import_models(doc, folder, created_materials, material_sets=None):
    """
    Import every .fbx / .obj under `folder` and give each object the material
    that belongs to it.

    Two ways to decide which material that is, in order:

      1. FOLDER. Each material set remembers the folder its textures were
         found in. A model imported from that same folder (or from its
         parent/child) gets that set's material. This is what makes the
         common "one folder per asset" layout work without depending on the
         object names inside the FBX being tidy.
      2. NAME. Failing that, the material whose identifier appears inside the
         object's name, longest match winning - the v1.1 behaviour, kept as
         the fallback for assets that all sit in one folder together.

    An object that matches neither is left alone and reported, rather than
    given an arbitrary material.
    """
    warnings = []
    if not folder or not os.path.isdir(folder):
        return ["Import 3D Model: '{}' is not a folder.".format(folder)]

    material_sets = material_sets or {}
    set_folders = {key: (ms.get("sourceFolder") or "")
                   for key, ms in material_sets.items()
                   if key in created_materials}

    model_files = []
    for root, dirs, files in os.walk(folder):
        dirs.sort()
        for fn in sorted(files):
            if fn.lower().endswith((".fbx", ".obj")):
                model_files.append(os.path.join(root, fn))

    # Imported one file at a time, so every object can be traced back to the
    # folder it came from. A single merge at the end loses that.
    imported = []   # [(object, folder it was imported from)]
    for path in model_files:
        before = get_all_objects(doc.GetFirstObject()) if doc.GetFirstObject() else []
        c4d.documents.MergeDocument(doc, path, c4d.SCENEFILTER_OBJECTS)
        after = get_all_objects(doc.GetFirstObject()) if doc.GetFirstObject() else []
        model_folder = os.path.dirname(path)
        for obj in after:
            if obj not in before:
                imported.append((obj, model_folder))

    only_material = None
    if len(created_materials) == 1:
        only_material = list(created_materials.values())[0]

    matched_by = {"only": 0, "folder": 0, "name": 0}

    for obj, model_folder in imported:
        try:
            doc.AddUndo(c4d.UNDOTYPE_NEW, obj)
        except Exception:
            pass

        material_to_apply = None

        if only_material is not None:
            material_to_apply = only_material
            matched_by["only"] += 1
        else:
            candidates = folder_candidates(model_folder, set_folders)
            if len(candidates) == 1:
                material_to_apply = created_materials.get(candidates[0])
                matched_by["folder"] += 1
            elif len(candidates) > 1:
                # Several sets share that folder - let the object's name pick
                # between them before widening the search.
                key = name_candidate(obj.GetName(), candidates) \
                    or name_candidate(obj.GetName(), created_materials.keys())
                if key is not None:
                    material_to_apply = created_materials.get(key)
                    matched_by["name"] += 1
                else:
                    warnings.append(
                        "'{}' - {} texture sets share its folder and its name "
                        "matches none of them, so no texture tag was added"
                        .format(obj.GetName(), len(candidates)))
                    continue
            else:
                key = name_candidate(obj.GetName(), created_materials.keys())
                if key is not None:
                    material_to_apply = created_materials.get(key)
                    matched_by["name"] += 1

        if material_to_apply is None:
            warnings.append("no matching material for object '{}' - no "
                            "texture tag added".format(obj.GetName()))
            continue

        tag = c4d.BaseTag(c4d.Ttexture)
        tag[c4d.TEXTURETAG_MATERIAL] = material_to_apply
        # Textures are UV-mapped; the default projection would be Spherical,
        # which stretches the maps across the model.
        tag[c4d.TEXTURETAG_PROJECTION] = c4d.TEXTURETAG_PROJECTION_UVW

        # LAST, not first. InsertTag() with no predecessor puts the tag at the
        # front of the list, and Cinema 4D gives precedence to the RIGHTMOST
        # texture tag - so an FBX that carries its own materials would have
        # overridden ours.
        existing = obj.GetTags()
        if existing:
            obj.InsertTag(tag, existing[-1])
        else:
            obj.InsertTag(tag)

    if imported:
        print("[Material Creator] tagged {} object(s) - {} by folder, {} by "
              "name, {} single-material".format(
                  matched_by["folder"] + matched_by["name"] + matched_by["only"],
                  matched_by["folder"], matched_by["name"], matched_by["only"]))

    return warnings


# --------------------------------------------------
# The build
# --------------------------------------------------
def build_materials(settings, status=None):
    """
    Create / update every material in `settings["materialSets"]`.

    The whole batch is one undo step, and progress goes to Cinema 4D's status
    bar (which repaints during a long loop, unlike a dialog gadget) plus the
    optional `status` callback.
    """
    def say(message):
        if status:
            try:
                status(message)
            except Exception:
                pass

    report = {"created": 0, "updated": 0, "skipped": 0,
              "failed": [], "warnings": []}

    doc = c4d.documents.GetActiveDocument()
    if doc is None:
        report["warnings"].append("No active document.")
        return report

    material_sets = settings.get("materialSets") or {}
    if not material_sets:
        return report

    if settings.get("copyTextures"):
        destination = doc.GetDocumentPath() or settings.get("folder")
        report["warnings"].extend(
            copy_material_textures(material_sets, destination))

    policy = settings.get("existingPolicy", EXISTING_UPDATE)
    created_materials = {}
    items = sorted(material_sets.items())
    total = len(items)

    doc.StartUndo()
    try:
        for index, (key, ms_content) in enumerate(items):
            name = ms_content.get("materialName", "RS Material")
            progress = "{}/{}  {}".format(index + 1, total, name)
            say(progress)
            c4d.StatusSetText("Redshift Material Creator: " + progress)
            c4d.StatusSetBar(int(100.0 * index / total))

            existing = doc.SearchMaterial(name)

            if existing is not None and policy == EXISTING_SKIP:
                report["skipped"] += 1
                continue

            if existing is not None and policy == EXISTING_UPDATE:
                try:
                    doc.AddUndo(c4d.UNDOTYPE_CHANGE, existing)
                except Exception:
                    pass
                ok, warnings = update_material_textures(existing, ms_content)
                report["warnings"].extend(warnings)
                if ok:
                    report["updated"] += 1
                    created_materials[key] = existing
                else:
                    report["failed"].append(name)
                continue

            data = ms_content.copy()
            data["gameAsset"] = settings.get("gameAsset", False)
            data["flipGreen"] = settings.get("flipGreen", False)
            mat, warnings = create_redshift_material(data)
            report["warnings"].extend(warnings)
            if mat:
                report["created"] += 1
                created_materials[key] = mat
            else:
                report["failed"].append(name)

        if settings.get("importObject") and created_materials:
            say("importing models")
            c4d.StatusSetText("Redshift Material Creator: importing models")
            report["warnings"].extend(
                import_models(doc, settings.get("folder"), created_materials,
                              material_sets))
    finally:
        doc.EndUndo()
        c4d.StatusClear()
        c4d.EventAdd()

    return report


def format_report_line(report):
    bits = []
    for label in ("created", "updated", "skipped"):
        if report[label]:
            bits.append("{} {}".format(report[label], label))
    if report["failed"]:
        bits.append("{} failed".format(len(report["failed"])))
    if not bits:
        bits.append("nothing to do")
    if report["warnings"]:
        bits.append("{} warning{}".format(
            len(report["warnings"]), "" if len(report["warnings"]) == 1 else "s"))
    return ", ".join(bits)


def report_problems(report):
    """
    Console always; a dialog ONLY when something went wrong. A clean run says
    nothing - the materials showing up in the Material Manager is enough.
    """
    print("[Material Creator] " + format_report_line(report))
    for warning in report["warnings"]:
        print("[Material Creator] " + warning)

    if not report["failed"] and not report["warnings"]:
        return

    summary = format_report_line(report)
    if report["failed"]:
        summary += "\n\nFailed: {}".format(", ".join(report["failed"]))
    if report["warnings"]:
        # The same problem usually repeats once per material, so collapse
        # identical messages (minus their "[material name] " prefix) rather
        # than printing thirty copies of one line.
        counts = {}
        order = []
        for warning in report["warnings"]:
            msg = warning.split("] ", 1)[1] if warning.startswith("[") \
                and "] " in warning else warning
            if msg not in counts:
                counts[msg] = 0
                order.append(msg)
            counts[msg] += 1
        summary += "\n\n{} warning{}:\n".format(
            len(order), "" if len(order) == 1 else "s")
        shown = order[:10]
        summary += "\n".join(
            "  - {}{}".format(m, "" if counts[m] == 1 else
                              "  (x{})".format(counts[m])) for m in shown)
        if len(order) > len(shown):
            summary += "\n  ... and {} more (see the console).".format(
                len(order) - len(shown))
    gui.MessageDialog(summary)


# --------------------------------------------------
# Entry points
#
# ONE file, two ways in:
#   * Script Manager - keep the .py extension, hit Execute. This stays a
#     first-class way to run the tool.
#   * Plugin - copy the file into a Cinema 4D "plugins" folder and rename it
#     to .pyp. It then registers a command you can put in a menu or bind to a
#     shortcut.
# The extension is what decides, so the same file does both.
# --------------------------------------------------
PLUGIN_ID = 1065432   # TODO: replace with an id registered at
                      # developers.maxon.net before sharing this with anyone.
                      # Unregistered ids can collide with another plugin.

_SCRIPT_DIALOG = None   # module-level so an async dialog opened from the
                        # Script Manager is not garbage collected


def open_tool():
    global _SCRIPT_DIALOG
    if _SCRIPT_DIALOG is None:
        _SCRIPT_DIALOG = MyDialog()
    _SCRIPT_DIALOG.Open(dlgtype=c4d.DLG_TYPE_ASYNC,
                        defaultw=460, defaulth=440)
    return True


class RSMaterialCreatorCommand(c4d.plugins.CommandData):
    def __init__(self):
        self.dialog = None

    def Execute(self, doc):
        if self.dialog is None:
            self.dialog = MyDialog()
        return self.dialog.Open(dlgtype=c4d.DLG_TYPE_ASYNC, pluginid=PLUGIN_ID,
                                defaultw=460, defaulth=440)

    def RestoreLayout(self, sec_ref):
        if self.dialog is None:
            self.dialog = MyDialog()
        return self.dialog.Restore(pluginid=PLUGIN_ID, secret=sec_ref)


def register_plugin():
    return c4d.plugins.RegisterCommandPlugin(
        PLUGIN_ID,
        "Redshift Material Creator",
        0,
        None,
        "Batch-build Redshift materials from a folder of PBR texture maps",
        RSMaterialCreatorCommand())


class RedshiftMaterialImporterTool(object):
    """Kept so older habits (and any script calling it) still work."""

    def run(self):
        return open_tool()


def _running_as_plugin():
    try:
        return os.path.splitext(__file__)[1].lower() == ".pyp"
    except NameError:
        return False


if __name__ == "__main__":
    if _running_as_plugin():
        register_plugin()
    else:
        open_tool()
