# --------------------------------------------------
# Copy Textures
# --------------------------------------------------
def safe_folder_name(name):
    """A material name reduced to something safe to use as a folder name."""
    cleaned = re.sub(r'[<>:"/\\|?*]', "_", name or "").strip(" .")
    return cleaned or "material"


def copy_material_textures(material_sets, destination_root):
    """
    Copy every referenced map into <destination_root>/tex/<material name>/ and
    repoint the material sets at the copies.

    One folder per material on purpose: v1.8 copied every map into a single
    flat 'tex' folder with shutil.copy2, so two texture sets that both export
    a file called BaseColor.png silently overwrote each other and the second
    material ended up pointing at the first one's map.
    """
    warnings = []
    if not destination_root:
        return ["Copy Textures: no project folder to copy into - skipped."]

    for key, ms_content in material_sets.items():
        folder = os.path.join(destination_root, "tex",
                              safe_folder_name(ms_content.get("materialName")))
        for channel in MATERIAL_CHANNELS:
            source = ms_content.get(channel)
            if not source or not isinstance(source, str):
                continue
            destination = os.path.join(folder, os.path.basename(source))
            try:
                if os.path.abspath(source) == os.path.abspath(destination):
                    continue
                if not os.path.isdir(folder):
                    os.makedirs(folder)
                shutil.copy2(source, destination)
                material_sets[key][channel] = destination
            except Exception as exc:
                warnings.append("could not copy '{}' ({})".format(
                    os.path.basename(source), exc))
    return warnings


# --------------------------------------------------
# Update an existing material in place
# --------------------------------------------------
EXISTING_CREATE_NEW = 0
EXISTING_UPDATE = 1
EXISTING_SKIP = 2


def update_material_textures(mat, file_paths):
    """
    Repoint the texture paths of a material this tool built earlier, leaving
    the rest of the graph - ramp tweaks, colour corrections, curvature
    settings - untouched.

    Nodes are found by the names the builder gives them ("BaseColor Tex" and
    friends), so this only works on generated materials. Returns
    (ok, warnings).
    """
    warnings = []
    name = mat.GetName()

    node_material = mat.GetNodeMaterialReference()
    if node_material is None or not node_material.HasSpace(RS_NODESPACE):
        return False, ["'{}' is not a Redshift node material - not updated.".format(name)]

    graph = node_material.GetGraph(RS_NODESPACE)
    if graph is None or graph.IsNullValue():
        return False, ["'{}' has no Redshift graph - not updated.".format(name)]

    nodes = []
    try:
        graph.GetRoot().GetInnerNodes(
            maxon.NODE_KIND.NODE, False,
            lambda node: (nodes.append(node), True)[1])
    except Exception as exc:
        return False, ["'{}' - could not read the graph ({}).".format(name, exc)]

    by_name = {}
    for node in nodes:
        try:
            node_name = str(node.GetValue(maxon.NODE.BASE.NAME))
        except Exception:
            continue
        if node_name:
            by_name[node_name] = node

    gb = GraphBuilder(graph, name)
    missing = []
    changed = 0
    with graph.BeginTransaction() as tr:
        try:
            for channel in MATERIAL_CHANNELS:
                path = file_paths.get(channel)
                if not path:
                    continue
                node = by_name.get("{} Tex".format(channel))
                if node is None:
                    missing.append(channel)
                    continue
                gb.set_texture(node, path, CHANNEL_COLORSPACES.get(
                    channel, "RS_INPUT_COLORSPACE_RAW"))
                changed += 1
            tr.Commit()
        except Exception as exc:
            tr.Rollback()
            return False, ["'{}' - update failed, rolled back ({}).".format(name, exc)]

    warnings.extend(gb.warnings)
    if missing:
        warnings.append("'{}' has no node for {} - those channels were not "
                        "updated. Set 'If material exists' to 'Create new' to "
                        "rebuild it.".format(name, ", ".join(missing)))
    c4d.EventAdd()
    return changed > 0, warnings


# --------------------------------------------------
# Folder scan (module level so it can be tested without opening the dialog)
# --------------------------------------------------
CHANNEL_ORDER = ["BaseColor", "AO", "Metalness", "Roughness", "Opacity",
                 "Normal", "Displacement"]


def scan_folder(folder, channel_keywords, recursive=True):
    """
    Walk `folder` and group texture files into material sets.

    channel_keywords: {"BaseColor": ["BaseColor", "Albedo"], ...} - only the
                      channels present in this dict are searched.

    Returns (channel_files, display_names, set_folders):
        channel_files[channel][key] -> absolute file path
        display_names[key]          -> identifier with its original spelling
        set_folders[key]            -> folder the set's first map was found in,
                                       used to pair models with materials

    `key` is a case/separator-insensitive form of the identifier, so
    "Wood_Planks_BaseColor.png" and "wood planks rough.png" still end up in
    the same material.
    """
    channel_files = {ch: {} for ch in channel_keywords}
    display_names = {}
    set_folders = {}

    if recursive:
        walked = []
        for root, dirs, files in os.walk(folder):
            dirs.sort()
            for fn in sorted(files):
                walked.append((root, fn))
    else:
        walked = [(folder, fn) for fn in sorted(os.listdir(folder))]

    for root, fn in walked:
        full_path = os.path.join(root, fn)
        if not os.path.isfile(full_path):
            continue
        if os.path.splitext(fn)[1].lower() not in TEXTURE_EXTENSIONS:
            continue

        for ch, keywords in channel_keywords.items():
            boundary = ch in BOUNDARY_MATCH_CHANNELS
            for kw in keywords:
                ident = extract_identifier(fn, kw, require_boundary=boundary)
                if ident is None:
                    continue
                if ch == "Normal":
                    ident = strip_normal_format_tokens(ident)
                key = identifier_key(ident)
                channel_files[ch][key] = full_path
                # Keep the first spelling we saw for this material.
                if key not in display_names or (ident and not display_names[key]):
                    display_names[key] = ident
                set_folders.setdefault(key, root)
                break

    return channel_files, display_names, set_folders


def folder_candidates(model_folder, set_folders):
    """
    Which material sets belong to the folder a model was imported from.

    Returns the closest matches as a list of keys (usually one, empty when no
    set shares a folder line with the model). Closeness is:
        0  the set's textures sit in the same folder as the model
        n  one is inside the other, n folders deep

    This is what makes "one folder per asset" work without relying on the
    object names inside the FBX being tidy.
    """
    if not model_folder or not set_folders:
        return []
    model = os.path.normcase(os.path.abspath(model_folder)).rstrip(os.sep)
    scored = []
    for key, folder in set_folders.items():
        if not folder:
            continue
        other = os.path.normcase(os.path.abspath(folder)).rstrip(os.sep)
        if other == model:
            scored.append((0, key))
        elif other.startswith(model + os.sep):
            scored.append((1 + other[len(model) + 1:].count(os.sep), key))
        elif model.startswith(other + os.sep):
            scored.append((1 + model[len(other) + 1:].count(os.sep), key))
    if not scored:
        return []
    best = min(score for score, _ in scored)
    return sorted(key for score, key in scored if score == best)


def name_candidate(object_name, keys):
    """
    The material key that appears inside an object's name, longest wins.
    Case and separators are ignored on both sides. None when nothing matches.
    """
    obj_key = identifier_key(object_name)
    best = None
    for key in keys:
        if key and key in obj_key:
            if best is None or len(key) > len(best):
                best = key
    return best


def build_material_name(base, ident):
    if base and ident:
        return "{}_{}".format(base, ident)
    return ident or base or "RS Material"


